                </image>
              </p>
          
            
        </p>
      </statement>
    </exercise>  

    <exercise number="8"><!-- #8 -->
      <statement>
        <p> 
          Given <m>\D f(x)=\frac{4+4x}{3x^{2/3}}</m> and <m>\D f'(x)=\frac{-8+4x}{9x^{5/3}}</m>, find 
          (a) intervals where the function is increasing and decreasing and (b) <m>x-</m>values of any local extrema.
        </p>
      </statement>
    </exercise> 

  
    </paragraphs>
  
    <paragraphs>
        <title>Now Grades Go Up</title>
    
      <exercise workspace="2in" number="1"><!-- #1 -->
        <statement>
          <p>
            Find the critical values of <m>\displaystyle h(x) = \frac{\sqrt{x^{2}+1}}{x-5}</m>.
              <ol marker="(a)">
                <li> <p> <m>x = -\frac{1}{5}</m> </p> </li>
                <li> <p> <m>x = 5</m> </p> </li>
                <li> <p> <m>x=0, 5</m> </p> </li>
                <li> <p> <m>x=-1, 0</m> </p> </li>
              </ol>
          </p>
        </statement>
      </exercise>
      <exercise workspace="2in" number="2"><!-- #2 -->
        <statement>
          <p>
            Which of the following is the equation of the line tangent to the curve <m>x^{3}+y^{2}=3x^{2}-y</m> at the point <m>(1,-1)?</m>
              <ol marker="(a)">
                <li> <p> <m>y=x</m></p> </li>
                <li> <p> <m>y=-x</m></p> </li>
                <li> <p><m>y = \frac{1}{2}x-3</m> </p></li>
                <li> <p> <m>y = -3x+2</m></p> </li>
              </ol>
          </p>
        </statement>
      </exercise>
    </paragraphs>

  </worksheet>

